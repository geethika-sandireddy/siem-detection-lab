<!--
  T1053.005 - Scheduled Task/Job: Scheduled Task
  Wazuh local rule.
  Requires: Advanced Audit Policy > Object Access > Audit Other Object Access Events (Success)
  auditpol /set /subcategory:"Other Object Access Events" /success:enable
-->
<group name="local,windows,persistence,">

  <rule id="100030" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4698$</field>
    <description>A new scheduled task was created (Event 4698).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Higher-fidelity companion: catches the schtasks.exe process directly,
       useful when 4698 auditing isn't enabled on a given host -->
  <rule id="100031" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>schtasks.exe invoked with /create — new scheduled task via command line.</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Extra suspicion: task created to run from a temp/user-writable path -->
  <rule id="100032" level="13">
    <if_sid>100031</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\\appdata\\|\\temp\\|\\users\\public\\)</field>
    <description>Scheduled task created pointing at a user-writable path (common persistence pattern).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>
