<!--
  T1110.001 - Brute Force: Password Guessing
  Wazuh local rule, drop into /var/ossec/etc/rules/local_rules.xml on the manager.
  Parent rule 5710 = "sshd: authentication failed" (from the default ruleset).
-->
<group name="local,ssh,brute_force,">

  <rule id="100010" level="10" frequency="8" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force attempt: 8+ failed logins from the same source IP within 2 minutes.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100011" level="12">
    <if_sid>100010</if_sid>
    <if_matched_sid>5715</if_matched_sid>
    <description>Possible successful brute force: accepted SSH login shortly after a burst of failures from the same source IP.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

</group>
